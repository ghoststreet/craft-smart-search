{% set pageKey = 'overview' %}

{% extends 'smart-search/index-mgmt/_layout' %}

{#
    The local cards render on the disconnected branch too. Same reasoning as the dashboard
    meter: the local store needs neither PostgreSQL nor the pgvector schema, so hiding its
    health behind a working pgvector connection would withhold it exactly when the other
    index is the thing that is broken.
#}
{% set localGrid %}
    {% if localSites|length %}
        <div class="ss-card-grid"
             data-craftsearch-target="local-grid"
             data-craftsearch-store="local">
            {% for site in localSites %}
                {% include 'smart-search/_partials/overview-site-card' with {
                    site: site, store: 'local',
                } only %}
            {% endfor %}
        </div>
    {% endif %}
{% endset %}

{#
    demo: only the local store's cards are shown. The pgvector grid and the onboarding /
    disconnected branches below are pgvector-state driven, so during the demo they would
    hide the local cards behind a PostgreSQL problem. Nothing is removed — uncomment the
    original block and delete the demo one to restore.
#}
{% block content %}
    {{ localGrid }}
{% endblock %}

