{% extends "_layouts/cp" %}
{% import 'smart-search/_components/badge' as b %}

{% set entry = inspection.entry %}
{% set chunkCount = inspection.chunks|length %}

{% set fieldsIndexed = inspection.fields|filter(f => f.indexed)|length %}

{% set chunkTokens = inspection.chunks|map(c => c.estimatedTokens) %}
{% set totalTokens = chunkTokens|reduce((sum, t) => sum + t, 0) %}
{% set maxChunkTokens = chunkCount ? max(chunkTokens) : 0 %}
{% set lastIndexed = inspection.lastIndexed %}

{% set fieldsSorted = inspection.fields|sort((x, y) => (y.indexed ? 1 : 0) <=> (x.indexed ? 1 : 0)) %}

{% set title = 'Inspect: ' ~ (entry.title ?: '(untitled)') %}
{% set selectedSubnavItem = 'index' %}

{% set crumbs = [
    { label: 'Smart Search', url: cpUrl('smart-search') },
    { label: 'Index'|t('smart-search'), url: cpUrl('smart-search/index') },
] %}

{% set isStale = inspection.status == 'stale' %}

{% set details %}
    <div class="meta read-only">
        <div class="data">
            <h5 class="heading">{{ 'Status'|t('smart-search') }}</h5>
            <div class="value">
                {% if chunkCount > 0 %}
                    <span class="status green"></span>{{ 'Indexed'|t('smart-search') }}
                {% else %}
                    <span class="status off"></span>{{ 'Not indexed'|t('smart-search') }}
                {% endif %}
            </div>
        </div>
        <div class="data">
            <h5 class="heading">{{ 'Section'|t('smart-search') }}</h5>
            <div class="value">{{ entry.section.name ?? '-' }}</div>
        </div>
        <div class="data">
            <h5 class="heading">{{ 'Chunks'|t('smart-search') }}</h5>
            <div class="value">{{ chunkCount }}</div>
        </div>
        <div class="data">
            <h5 class="heading">{{ 'Fields indexed'|t('smart-search') }}</h5>
            <div class="value">{{ fieldsIndexed }} / {{ inspection.fields|length }}</div>
        </div>
        <div class="data">
            <h5 class="heading">{{ 'Tokens'|t('smart-search') }}</h5>
            <div class="value">~{{ totalTokens }}</div>
        </div>
        <div class="data">
            <h5 class="heading">{{ 'Last indexed'|t('smart-search') }}</h5>
            <div class="value">{{ lastIndexed ? lastIndexed|date('M j, Y g:i A') : '-' }}</div>
        </div>
        <div class="data">
            <h5 class="heading">{{ 'Content updated'|t('smart-search') }}</h5>
            <div class="value">
                {{ entry.dateUpdated|date('M j, Y g:i A') }}
                {% if isStale %}
                    <span title="{{ 'Edited after the last index run'|t('smart-search') }}">{{ b.badge('Stale'|t('smart-search'), 'orange') }}</span>
                {% endif %}
            </div>
        </div>
    </div>
    <div class="meta read-only">
        {% if craft.app.getIsMultiSite() %}
            <div class="data">
                <h5 class="heading">{{ 'Site'|t('smart-search') }}</h5>
                <div class="value">{{ entry.site.name ?: entry.site.handle }}</div>
            </div>
        {% endif %}
        {% if entry.url %}
            <div class="data">
                <h5 class="heading">{{ 'Live URL'|t('smart-search') }}</h5>
                <div class="value"><a href="{{ entry.url }}" target="_blank" rel="noopener">{{ 'View live'|t('smart-search') }} ↗</a></div>
            </div>
        {% endif %}
        {% if entry.cpEditUrl %}
            <div class="data">
                <h5 class="heading">{{ 'Entry'|t('smart-search') }}</h5>
                <div class="value"><a href="{{ entry.cpEditUrl }}">{{ 'Go to Entry'|t('smart-search') }}</a></div>
            </div>
        {% endif %}
    </div>
{% endset %}

{% macro fieldCard(field, depth) %}
    {% from _self import fieldCard %}
    {% import 'smart-search/_components/badge' as b %}
    {% set hasBlocks = field.blocks is not empty %}
    {% set hasText = field.extractedText is not empty %}
    {% set head %}
        <span class="status {{ field.indexed ? 'green' : 'off' }}" aria-label="{{ (field.indexed ? 'Indexed' : 'Not indexed')|t('smart-search') }}"></span>
        <code class="ss-field-card__handle">{{ field.handle }}</code>
        <span class="ss-field-card__type">{{ field.type }}</span>
        <span class="flex-grow"></span>
        {% if field.indexed %}
            {{ b.badge(hasBlocks ? field.blocks|length ~ ' ' ~ 'block(s)'|t('smart-search') : 'Indexed'|t('smart-search'), 'green') }}
        {% elseif field.reason %}
            {{ b.badge(field.reason, 'gray') }}
        {% endif %}
    {% endset %}
    {% set body %}
        {% if hasBlocks %}
            <div class="ss-field-card__blocks">
                {% for block in field.blocks %}
                    <section class="ss-field-card__block">
                        <h4 class="ss-small-caps ss-field-card__block-title">
                            <code class="ss-field-card__block-handle">{{ block.label }}</code>
                            {% if block.id %}<span class="light">#{{ block.id }}</span>{% endif %}
                        </h4>
                        {% if block.fields|length %}
                            <div class="ss-field-card__children">
                                {% for sub in block.fields %}
                                    {{ fieldCard(sub, depth + 1) }}
                                {% endfor %}
                            </div>
                        {% else %}
                            <p class="light">{{ 'No fields.'|t('smart-search') }}</p>
                        {% endif %}
                    </section>
                {% endfor %}
            </div>
        {% elseif hasText %}
            <div class="ss-field-card__body">
                <pre class="ss-field-card__text">{{ field.extractedText }}</pre>
            </div>
        {% endif %}
    {% endset %}
    {% include 'smart-search/_components/expandable-card' with {
        expandable: hasBlocks or hasText,
        class: 'ss-field-card ss-field-card--depth-' ~ depth ~ ' ss-field-card--' ~ (field.indexed ? 'indexed' : 'skipped'),
        headClass: 'ss-field-card__head',
        head: head,
        body: body,
    } only %}
{% endmacro %}

{% from _self import fieldCard %}

{% block content %}
    <div class="pane">
        <header class="pane-header flex">
            <h2 class="my-0">{{ 'Fields'|t('smart-search') }} <span class="light">({{ inspection.fields|length }})</span></h2>
        </header>
        <p class="instructions">{{ 'Each card shows a field and the exact text contributed to the index. Skipped fields explain why.'|t('smart-search') }}</p>

        {% if inspection.fields|length %}
            <div class="ss-field-card-list">
                {% for field in fieldsSorted %}
                    {{ fieldCard(field, 0) }}
                {% endfor %}
            </div>
        {% else %}
            <div class="zilch"><p>{{ 'No custom fields.'|t('smart-search') }}</p></div>
        {% endif %}
    </div>

    {% if inspection.boosts|length %}
        <div class="pane ss-index-entry__boosts">
            <header class="pane-header flex">
                <h2 class="my-0">{{ 'Search boosts'|t('smart-search') }} <span class="light">({{ inspection.boosts|length }})</span></h2>
            </header>
            <p class="instructions">{{ 'When a search contains one of the phrases below, this entry is moved toward the top of the results. If several boosted entries match the same search, the one with the higher priority appears first. These rules are set in code (indexBoosts event) and can’t be edited here.'|t('smart-search') }}</p>
            <ul class="ss-index-entry__boost-list">
                {% for boost in inspection.boosts %}
                    <li class="ss-card ss-boost-rule flex flex-nowrap flex-gap-m">
                        <span class="ss-boost-rule__trigger">
                            {{ 'Search for'|t('smart-search') }}
                            <code class="ss-boost-rule__phrase">{{ boost.label }}</code>
                        </span>
                        <span class="ss-boost-rule__priority" title="{{ 'Higher priority ranks first among boosted entries'|t('smart-search') }}">{{ 'priority {weight}'|t('smart-search', { weight: boost.weight }) }}</span>
                    </li>
                {% endfor %}
            </ul>
        </div>
    {% endif %}

    <div class="pane ss-index-entry__chunks">
        <header class="pane-header flex">
            <h2 class="my-0">{{ 'Chunks'|t('smart-search') }} <span class="light">({{ chunkCount }})</span></h2>
        </header>
        <p class="instructions">{{ 'Each chunk is a slice of this entry’s indexed text, scored on its own so a long entry can match on the part that is relevant. Read in order, they reconstruct the full indexed text: the entry title, then each field’s text.'|t('smart-search') }}</p>

        {% if chunkCount %}
            <div class="ss-chunk-list">
                {% for chunk in inspection.chunks %}
                    {% include 'smart-search/index-mgmt/_chunk-row' with { chunk: chunk, maxTokens: maxChunkTokens } only %}
                {% endfor %}
            </div>
        {% else %}
            <div class="zilch">
                <p>{{ 'No chunks stored. This entry is not indexed yet.'|t('smart-search') }}</p>
            </div>
        {% endif %}
    </div>
{% endblock %}
