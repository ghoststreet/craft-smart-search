<p class="light">Queries that returned no results. These often reveal missing content or overly strict thresholds.</p>
{% if page.items|length %}
    {% embed 'smart-search/_components/data-table' with { columns: [
        { label: 'Query' },
        { label: 'Searches', class: 'thin rightalign' },
        { label: 'Last searched', class: 'thin' },
    ] } %}
        {% block rows %}
            {% for k in page.items %}
                <tr>
                    <td>{{ k.query|truncate(100) }}</td>
                    <td class="thin rightalign">{{ k.hits|number_format }}</td>
                    <td class="thin"><span class="light" title="{{ k.lastSeen|date('Y-m-d H:i:s') }}">{{ k.lastSeen|date('M j, g:ia') }}</span></td>
                </tr>
            {% endfor %}
        {% endblock %}
    {% endembed %}
{% else %}
    {% include 'smart-search/_components/empty-state' with {
        variant: 'positive',
        title: hasActiveFilters ? 'Nothing failed in this slice' : 'Every search found something',
        text: hasActiveFilters
            ? 'No zero-result queries match these filters. Clear them to check every period.'
            : 'No zero-result queries recorded. Search is serving your audience well.',
        clearUrl: hasActiveFilters ? clearUrl : null,
    } only %}
{% endif %}

{% include 'smart-search/_components/pagination' with {
    page: page,
    path: 'smart-search/insights',
    params: { report: 'zero-results', days: filters.days, siteId: filters.siteId },
} only %}
