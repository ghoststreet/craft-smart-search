{#
    A single site's index health card on the Overview tab, for either store.

    Params:
        site   object  per-site row (siteId, name, indexed, stale, notIndexed, total,
                       lastIndexed, activeJob?)
        store  string  'pgvector' (default) or 'local'

    One partial rather than two, because everything that differs between the stores is
    the pair of action names and a label. The counts, the states and the gap wording all
    describe the content, which is the same content either way.

    State derivation mirrors the JS in index-mgmt.js so initial paint matches
    the first poll response.
#}
{% set store = store ?? 'pgvector' %}
{% set isLocal = store == 'local' %}
{% set syncAction = isLocal ? 'smart-search/index/local-sync' : 'smart-search/index/sync' %}
{% set defaultButtonLabel = isLocal ? 'Reindex local' : 'Sync Index' %}
{% set hasGaps = site.stale > 0 or site.notIndexed > 0 %}
{% set coverage = site.total > 0 ? (site.indexed / site.total * 100)|round : 0 %}
{% set activeJob = site.activeJob ?? null %}
{% set jobRunning = activeJob and activeJob.status == 2 %}

{% if activeJob %}
    {% set state = 'indexing' %}
{% elseif not site.lastIndexed or site.indexed == 0 %}
    {% set state = 'not-synced' %}
{% elseif hasGaps %}
    {% set state = 'needs-sync' %}
{% else %}
    {% set state = 'synced' %}
{% endif %}

{% set p = { heroPrefix: 'entries indexed · ', buttonLabel: defaultButtonLabel }|merge({
    'synced':     { pillLabel: 'Healthy',    pillDot: 'on' },
    'needs-sync': { pillLabel: 'Needs sync', pillDot: 'orange' },
    'not-synced': { pillLabel: 'Not synced', pillDot: 'off' },
    'indexing':   { pillLabel: jobRunning ? 'Indexing' : 'Queued', pillDot: 'blue',
                    heroPrefix: jobRunning ? 'indexing · ' : 'waiting for worker · ', buttonLabel: 'Cancel' },
}[state]) %}

<div class="ss-card" data-craftsearch-target="site-card" data-craftsearch-state="{{ state }}"
     data-craftsearch-site-id="{{ site.siteId }}"
     data-craftsearch-store="{{ store }}"
     data-craftsearch-default-label="{{ defaultButtonLabel }}">
    <div class="ss-card__head">
        <h3 class="ss-card__title">{{ site.name }}{% if isLocal %} - local{% endif %}</h3>
        <span class="ss-card__pill" data-craftsearch-target="pill">
            <span class="status {{ p.pillDot }}" data-craftsearch-target="pill-dot"></span>
            <span data-craftsearch-target="pill-label">{{ p.pillLabel }}</span>
        </span>
    </div>

    <div class="ss-card__hero">
        <div class="ss-card__hero-number">
            <span data-craftsearch-target="hero-indexed">{{ site.indexed }}</span><span class="ss-card__hero-total"> / <span data-craftsearch-target="hero-total">{{ site.total }}</span></span>
        </div>
        <div class="ss-card__hero-label" data-craftsearch-target="hero-label">{{ p.heroPrefix }}<span data-craftsearch-target="hero-percent">{{ coverage }}</span>%</div>
        <div class="ss-card__progress" data-craftsearch-target="site-progress"{% if not activeJob %} hidden{% endif %}>
            <div data-craftsearch-target="site-progress-bar"></div>
            <p class="error smalltext" data-craftsearch-target="site-progress-error" hidden></p>
        </div>
    </div>

    <ul class="ss-card__gaps" data-craftsearch-target="gaps"{% if not hasGaps or activeJob %} hidden{% endif %}>
        <li data-craftsearch-target="gap-stale"{% if site.stale == 0 %} hidden{% endif %}>
            <span class="status orange"></span> <strong data-craftsearch-target="gap-stale-count">{{ site.stale }}</strong> stale <span class="light">(edited since last sync)</span>
        </li>
        <li data-craftsearch-target="gap-not-indexed"{% if site.notIndexed == 0 %} hidden{% endif %}>
            <span class="status off"></span> <strong data-craftsearch-target="gap-not-indexed-count">{{ site.notIndexed }}</strong> not indexed <span class="light">(never embedded)</span>
        </li>
    </ul>

    <div class="ss-card__footer">
        <div class="ss-card__meta">
            <span data-craftsearch-target="last-sync">
                {% if site.lastIndexed %}
                    Last sync {{ site.lastIndexed|datetime('short') }}
                {% else %}
                    Never synced
                {% endif %}
            </span>
            {% if isLocal and site.chunkCount is defined %}
                <span class="light">· {{ site.chunkCount|number_format }} chunks</span>
            {% endif %}
        </div>
        <form method="post">
            {{ csrfInput() }}
            {{ actionInput(syncAction) }}
            <input type="hidden" name="siteId" value="{{ site.siteId }}">
            <input type="hidden" name="store" value="{{ store }}">
            <button type="submit" class="btn{% if not isLocal %} submit{% endif %}" data-craftsearch-control="sync-site-btn">
                <span data-craftsearch-target="button-label">{{ p.buttonLabel }}</span>
            </button>
        </form>
    </div>
</div>
