{% import '_includes/forms.twig' as forms %}

{% namespace 'settings' %}
<h2>Chunking</h2>
<p class="light">Long entries are split into smaller pieces so ranking can score sections instead of the whole entry. Sizes are in tokens (about 4 characters each). <a href="{{ wikiUrl }}/Indexing-Your-Content#chunking" target="_blank" rel="noopener">Learn more</a>.</p>

    {{ forms.textField({
        label: 'Smallest chunk size (tokens)',
        instructions: 'Pieces shorter than this are merged into the next one. Raise it if results show short fragments. Default <code>' ~ defaults.minChunkTokens ~ '</code>.',
        id: 'minChunkTokens', name: 'minChunkTokens', value: settings.minChunkTokens, type: 'number', min: '10', max: '500', required: true, errors: settings.getErrors('minChunkTokens'), disabled: readOnly }) }}
    {{ forms.textField({
        label: 'Target chunk size (tokens)',
        instructions: 'Smart Search aims for this size when splitting. Bigger chunks give more context per result but match less precisely. Default <code>' ~ defaults.targetChunkTokens ~ '</code>.',
        id: 'targetChunkTokens', name: 'targetChunkTokens', value: settings.targetChunkTokens, type: 'number', min: '100', max: '1000', required: true, errors: settings.getErrors('targetChunkTokens'), disabled: readOnly }) }}
    {{ forms.textField({
        label: 'Largest chunk size (tokens)',
        instructions: 'Hard upper limit. Keep it above the target size. Default <code>' ~ defaults.maxChunkTokens ~ '</code>.',
        id: 'maxChunkTokens', name: 'maxChunkTokens', value: settings.maxChunkTokens, type: 'number', min: '200', max: '2000', required: true, errors: settings.getErrors('maxChunkTokens'), disabled: readOnly }) }}
    {{ forms.textField({
        label: 'Chunk overlap (tokens)',
        instructions: 'How many tokens neighbouring chunks share, so a sentence split across a boundary still matches. Set to <code>0</code> to turn off. Default <code>' ~ defaults.overlapTokens ~ '</code>.',
        id: 'overlapTokens', name: 'overlapTokens', value: settings.overlapTokens, type: 'number', min: '0', max: '200', required: true, errors: settings.getErrors('overlapTokens'), disabled: readOnly }) }}
    {{ forms.textField({
        label: 'Skip chunking below (tokens)',
        instructions: 'Entries shorter than this are indexed whole. Default <code>' ~ defaults.chunkThresholdTokens ~ '</code>.',
        id: 'chunkThresholdTokens', name: 'chunkThresholdTokens', value: settings.chunkThresholdTokens, type: 'number', min: '100', max: '1000', required: true, errors: settings.getErrors('chunkThresholdTokens'), disabled: readOnly }) }}

{% if settings.hasProviderKey() %}
<hr>

<h2>Cache</h2>

    {{ forms.textField({
        label: 'Embedding cache lifetime (days)',
        instructions: 'Saves money by reusing a vector instead of paying for the same text twice. Edited entries always get a fresh one. Set to <code>0</code> to turn off. Default <code>' ~ defaults.embeddingCacheTtlDays ~ '</code>.',
        id: 'embeddingCacheTtlDays', name: 'embeddingCacheTtlDays',
        value: settings.embeddingCacheTtlDays, type: 'number', min: '0', max: '30',
        required: true, errors: settings.getErrors('embeddingCacheTtlDays'),
        disabled: readOnly,
    }) }}
{% endif %}

<hr>

<h2>Sections</h2>
<p class="light">Choose which sections Smart Search indexes. Sections without URLs start off because their results have no page to link to. Turn one on if its content should still feed AI answers. <a href="{{ wikiUrl }}/Indexing-Your-Content#choosing-sections" target="_blank" rel="noopener">Learn more</a>.</p>

    {% set urlLabels = { yes: 'Yes', some: 'Some sites', no: 'No' } %}
    {% embed 'smart-search/_components/data-table' with { columns: [
        { label: 'Section' },
        { label: 'Type', class: 'thin' },
        { label: 'Has URLs', class: 'thin' },
        { label: 'Indexed', class: 'thin' },
    ] } %}
        {% block rows %}
            {% import '_includes/forms.twig' as forms %}
            {% for row in sectionRows %}
                <tr>
                    <td><span id="section-{{ row.uid }}">{{ row.name }}</span> <span class="light">({{ row.entries|number }})</span></td>
                    <td class="thin">{{ row.type|capitalize }}</td>
                    <td class="thin">{{ urlLabels[row.urls] }}</td>
                    <td class="thin">
                        {{ forms.lightswitch({
                            name: 'indexedSections[' ~ row.uid ~ ']',
                            on: row.indexed,
                            small: true,
                            labelledBy: 'section-' ~ row.uid,
                            disabled: readOnly,
                        }) }}
                    </td>
                </tr>
            {% endfor %}
        {% endblock %}
    {% endembed %}
<p class="light">Turning a section off removes its entries from the index when you save. Turning one on queues them for indexing.</p>

{% endnamespace %}
